{
  "installCommand": "echo no-dependencies",
  "buildCommand": "node scripts/build-frontend.js",
  "outputDirectory": "frontend",
  "rewrites": [{ "source": "/((?!.*\\.[A-Za-z0-9]+$).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Permissions-Policy", "value": "camera=(self), geolocation=(self), accelerometer=(self), gyroscope=(self), microphone=()" } ] },
    { "source": "/service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/js/config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
